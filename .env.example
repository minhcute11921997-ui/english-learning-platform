# ==========================================
# EngLearn Root Environment (Docker Compose)
# ==========================================
NODE_ENV=development
SEED_DEMO=false

# Database (KHÔNG dùng mật khẩu mặc định khi deploy production)
MYSQL_ROOT_PASSWORD=change_me_root_password_32chars
DB_NAME=english_learning
DB_USER=englearn_user
DB_PASSWORD=change_me_db_password_32chars
DB_EXTERNAL_PORT=3307

# JWT Secrets (Production bắt buộc >= 32 ký tự ngẫu nhiên, khác nhau)
# Tạo bằng: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=

# Domain / URLs
CLIENT_URL=http://localhost:5173
CLIENT_HTTP_PORT=5173
SERVER_PORT=3000

# Bảo mật đăng nhập
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# Email / SMTP (Để trống SMTP_HOST nếu chạy local log-only)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=EngLearn <noreply@englearn.art>

# Google OAuth 2.0 / Google Identity Services
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# AI Vision Service
AI_ENABLED=true
AI_SERVICE_URL=http://ai-service:8001
AI_TIER2_MODE=off
OLLAMA_URL=http://host.docker.internal:11434
AI_VISION_MODEL=qwen2.5vl:7b
