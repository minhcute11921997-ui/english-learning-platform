# Server
PORT=3000
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=english_learning
DB_USER=root
DB_PASSWORD=

# JWT
JWT_SECRET=your-super-secret-key-change-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production
JWT_REFRESH_EXPIRES_IN=30d

# Upload
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# ==========================================
# AI Translation Provider (Tùy chọn)
# ==========================================
# Đặt thành "true" để kích hoạt AI dịch (ưu tiên hơn Google Translate)
# Khi false (mặc định), hệ thống dùng Google Translate + MyMemory fallback
TRANSLATE_AI_ENABLED=false

# API Key và URL của AI model EN-VI (điền khi có model)
# TRANSLATE_AI_API_KEY=your-ai-api-key-here
# TRANSLATE_AI_MODEL_URL=https://your-model-endpoint.com/v1/translate
