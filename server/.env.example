# Server
PORT=3000
NODE_ENV=development
SEED_DEMO=false

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=english_learning
DB_NAME_TEST=english_learning_test
DB_USER=root
DB_PASSWORD=

# JWT
JWT_SECRET=your-super-secret-key-change-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production
JWT_REFRESH_EXPIRES_IN=30d

# Upload
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Account Lockout & Security
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15
PASSWORD_RESET_TTL_MINUTES=15

# SMTP Email (Quên mật khẩu & Xác minh email)
# Để trống SMTP_HOST ở chế độ development để ghi log nội dung email ra console
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=EngLearn <noreply@englearn.art>

# Google OAuth 2.0 / Google Identity Services
GOOGLE_CLIENT_ID=

# ==========================================
# AI Translation Provider (Tùy chọn)
# ==========================================
# Đặt thành "true" để kích hoạt AI dịch (ưu tiên hơn Google Translate)
# Khi false (mặc định), hệ thống dùng Google Translate làm fallback
TRANSLATE_AI_ENABLED=false

# Provider: hiện tại hỗ trợ "ollama" (model chạy local)
TRANSLATE_AI_PROVIDER=ollama

# Ollama server URL (máy có RTX 3060 chạy model fine-tuned EN↔VI)
# Nếu cùng máy: http://localhost:11434
# Nếu máy khác: http://<IP_MAY_RTX>:11434
OLLAMA_BASE_URL=http://localhost:11434

# Tên model đã đăng ký với Ollama (xem tools/training/README.md)
OLLAMA_MODEL=vi-en-translator

# Timeout mỗi request AI (ms) — tăng nếu máy chậm
TRANSLATE_AI_TIMEOUT_MS=8000

# ==========================================
# AI Vision Recognition (Local Cascade)
# ==========================================
AI_ENABLED=true
# Tier 1: SigLIP FastAPI microservice (micro-batched on CUDA)
AI_SERVICE_URL=http://localhost:8001
# Tier 2: Chế độ tinh chỉnh VLM ('off' mặc định để tối đa tốc độ & tiết kiệm 6GB VRAM, hoặc 'async' | 'sync')
AI_TIER2_MODE=off
OLLAMA_URL=http://localhost:11434
AI_VISION_MODEL=qwen2.5vl:7b
AI_TIER1_TIMEOUT_MS=5000
AI_TIER2_TIMEOUT_MS=15000
AI_TIER2_CONCURRENCY=1
AI_TIER2_MAX_QUEUE=20
AI_CACHE_MAX=1000
AI_CACHE_TTL_MS=1800000
