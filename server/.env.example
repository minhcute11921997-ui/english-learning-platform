# Server
PORT=3000
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=english_learning
DB_USER=root
DB_PASSWORD=

# JWT
JWT_SECRET=your-super-secret-key-change-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production
JWT_REFRESH_EXPIRES_IN=30d

# Upload
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# ==========================================
# AI Translation Provider (Tùy chọn)
# ==========================================
# Đặt thành "true" để kích hoạt AI dịch (ưu tiên hơn Google Translate)
# Khi false (mặc định), hệ thống dùng Google Translate làm fallback
TRANSLATE_AI_ENABLED=false

# Provider: hiện tại hỗ trợ "ollama" (model chạy local)
TRANSLATE_AI_PROVIDER=ollama

# Ollama server URL (máy có RTX 3060 chạy model fine-tuned EN↔VI)
# Nếu cùng máy: http://localhost:11434
# Nếu máy khác: http://<IP_MAY_RTX>:11434
OLLAMA_BASE_URL=http://localhost:11434

# Tên model đã đăng ký với Ollama (xem tools/training/README.md)
OLLAMA_MODEL=vi-en-translator

# Timeout mỗi request AI (ms) — tăng nếu máy chậm
TRANSLATE_AI_TIMEOUT_MS=8000
